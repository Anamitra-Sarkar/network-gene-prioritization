# Copy to .env and fill in real values (never commit real secrets).
# Each var below is actually read in code (checked via grep for os.getenv / import.meta.env).

# --- Backend: release gate (fail-closed; both required to enable real inference) ---
# Whether a trained model artifact has been approved for serving (must be "true" to enable)
MODEL_RELEASE_APPROVED=false
# Approved artifact revision directory name under ARTIFACT_DIR (e.g. rev-2026-08-31)
APPROVED_ARTIFACT_REVISION=
# Directory containing artifact revisions (each revision is a subdirectory)
ARTIFACT_DIR=artifacts

# --- Backend: service-token gate for POST /api/v1/prioritize (fail-closed if unset) ---
# Shared secret for internal calls to /prioritize (send as X-Service-Token or Authorization: Bearer)
SERVICE_TOKEN=change-me-to-a-random-secret
# Alias for SERVICE_TOKEN (accepted as fallback)
INTERNAL_SERVICE_TOKEN=

# --- Backend: Firebase Admin (for GET /api/v1/me and optional auth) ---
# Either a file path to a Firebase service-account JSON or the raw JSON string itself
FIREBASE_ADMIN_JSON=
# Alias for FIREBASE_ADMIN_JSON
FIREBASE_SERVICE_ACCOUNT=
# Dev bypass: set "true" to allow anonymous /me without Firebase token (local dev only)
ALLOW_ANONYMOUS=true

# --- Data pipeline: DisGeNET access (only needed for download/training, not for serving) ---
# API key for disgenet.com (or provide a pre-downloaded file via DISGENET_FILE / --disgenet)
DISGENET_API_KEY=
# Alternative legacy auth (some exports mention email/password)
DISGENET_EMAIL=
DISGENET_PASSWORD=
# Path to a pre-downloaded DisGeNET curated TSV (used instead of API)
DISGENET_FILE=data/raw/disgenet_curated.tsv

# --- Frontend: Firebase JS SDK config (Vite env vars; prefix VITE_ required) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Frontend: API base URL (where the FastAPI backend is reachable) ---
# Frontend reads VITE_API_URL (preferred) or VITE_API_BASE (backwards compat); defaults to "" (relative /api proxy in dev)
VITE_API_URL=http://localhost:8000
# Alias kept for compatibility with existing frontend/.env.example
VITE_API_BASE=http://localhost:8000
