# Firebase JS SDK (set these to enable auth; frontend works in preview mode without them)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# API base URL for backend (VITE_API_URL preferred, VITE_API_BASE alias for compatibility)
# Defaults to "" (relative /api via Vite proxy in dev) if unset.
VITE_API_URL=http://localhost:8000
VITE_API_BASE=http://localhost:8000
